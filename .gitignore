# 依赖与构建产物
node_modules
dist
plugins/*/dist

# 插件构建产物（由 `node plugins/build-plugins.mjs` 生成，含 registry.json）
# 不入库：避免把构建产物里可能存在的敏感值固化进历史
public/plugins

# 宿主运行态数据（owner 哈希、会话哈希、供应商密钥）—— 绝不入库
.polaris-lite
*.local

# 环境与编辑器
.env
.env.*
.DS_Store
Thumbs.db
.idea
.vscode
*.log

# 调试/诊断产物（CDP 探针、网络导出、浏览器用户数据）——不属于交付
tests/_*
tests/.chrome-net/
docs/*.png

# 开发环境独立数据目录（dev:standalone）
.polaris-lite-dev/

# Capacitor Android 构建产物与本地签名（keystore 不入库）
android/
android-signing/
plite-*.apk

# 运行时数据目录（含明文密钥/会话/对话，禁止入库）
.polaris-lite-pm2/
.polaris-lite/
.polaris-lite-dev/
nonexistent-dir-for-test/
