# 依赖与构建产物
node_modules
dist
plugins/*/dist

# vite 读取配置时在仓库根留下的临时文件（每次 build 都变，不该进 dirty 统计）
vite.config.ts.timestamp-*

# 插件构建产物（由 `node plugins/build-plugins.mjs` 生成，含 registry.json）
# 不入库：避免把构建产物里可能存在的敏感值固化进历史
public/plugins

# 宿主运行态数据（owner 哈希、会话哈希、供应商密钥）—— 绝不入库
.polaris-lite
*.local

# 环境与编辑器
.env
.env.*
.DS_Store
Thumbs.db
.idea
.vscode
*.log

# 调试/诊断产物（CDP 探针、网络导出、浏览器用户数据）——不属于交付
tests/_*
tests/.chrome-net/
docs/*.png

# 开发环境独立数据目录（dev:standalone）
.polaris-lite-dev/

# Capacitor Android 构建产物与本地签名（keystore 不入库）
android/
android-signing/
plite-*.apk

# 运行时数据目录（含明文密钥/会话/对话，禁止入库）
.polaris-lite-pm2/
.polaris-lite/
.polaris-lite-dev/
nonexistent-dir-for-test/

# 临时调试产物（session cookie / 登录凭据 / hook 日志）——不入库
.tmp-*
.polaris-liteworkspace*
.claude/hook-log.jsonl

# 发版/打包产物（apk、便携包、手工备份）——不入库
/polaris-lite-*.apk
/plite-*-release.apk
/polaris-lite-portable/
/polaris-lite-portable.zip
/backup-*-manual/
# 误落在仓库内的同名残留副本（只剩 plugins/ 的旧拷贝）
/polaris-lite/

# GUI 冒烟截图与运行日志（每轮验证都会新增，不属于交付）
/gui-test-screenshots/
/logs/
# 探针脚本导出的登录凭据，绝不入库
/dev-cookies.tmp.txt

# 测试目录内误建的嵌套目录
/tests/tests/

# 脚本备份
/*.bak

nul

/test-rabbit.html
