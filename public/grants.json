{
  "version": 2,
  "unlistedPolicy": "declare",
  "plugins": {
    "config-manager": {
      "capabilities": [],
      "provides": ["cap.config"],
      "events": ["config-changed"]
    },
    "chat-lite": {
      "capabilities": ["cap.ai.chat", "cap.ai.chat.interrupt"],
      "provides": [],
      "events": ["cap.ai.chat:event"]
    },
    "model-admin": {
      "capabilities": ["cap.model.admin"],
      "provides": ["cap.model.admin"],
      "events": ["model-config-changed"]
    },
    "real-engine": {
      "capabilities": ["cap.model.admin"],
      "provides": ["cap.ai.chat", "cap.ai.chat.interrupt"],
      "events": ["model-config-changed", "auth-changed"]
    },
    "cap-panel": {
      "capabilities": ["cap.meta"],
      "provides": [],
      "events": []
    },
    "mock-auth": {
      "capabilities": ["cap.auth"],
      "provides": ["cap.auth"],
      "events": ["auth-changed"]
    },
    "mock-engine": {
      "capabilities": [],
      "provides": ["cap.ai.chat", "cap.ai.chat.interrupt"],
      "events": []
    },
    "theme-switcher": {
      "capabilities": [],
      "provides": [],
      "events": []
    }
  }
}
