{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["vite/client"],
    "paths": {
      "@sdk": ["plugins/sdk/index.ts"],
      "@sdk/*": ["plugins/sdk/*"]
    }
  },
  "include": ["plugins/**/*.ts", "plugins/**/*.tsx"],
  "exclude": ["node_modules", "plugins/*/dist", "public", "plugins/shared.plugin-config.ts", "plugins/*/vite.config.ts"]
}
